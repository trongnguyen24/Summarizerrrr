{
  "name": "Summarizerrrr",
  "description": "Extension helps you summarize for YouTube, Udemy, Coursera, any websites. Crafted with superior UI/UX design.",
  "private": true,
  "version": "2.12.2",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "dev:safari": "wxt -b safari",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "build:safari": "wxt build -b safari",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "zip:safari": "wxt zip -b safari",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "icons:sync": "node build/icons/iconBundlePlugin.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "wxt prepare",
    "android": "web-ext run --target=firefox-android --android-device ${ANDROID_DEVICE:-emulator-5554} --firefox-apk ${FIREFOX_APK:-org.mozilla.fenix} --source-dir .output/firefox-mv2 --adb-remove-old-artifacts",
    "android:win": "web-ext run --target=firefox-android --android-device 177a8d45 --firefox-apk org.mozilla.fenix --source-dir .output/firefox-mv2 --adb-remove-old-artifacts"
  },
  "devDependencies": {
    "@ai-sdk/svelte": "^5.0.22",
    "@iconify/svelte": "^5.0.0",
    "@tailwindcss/typography": "^0.5.16",
    "@tsconfig/svelte": "^5.0.4",
    "@wxt-dev/module-svelte": "^2.0.3",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "29.1.1",
    "svelte": "^5.56.4",
    "svelte-check": "^4.1.6",
    "tslib": "^2.8.1",
    "typescript": "^5.8.3",
    "vitest": "^4.1.10",
    "wxt": "^0.20.6"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.12",
    "@ai-sdk/cerebras": "^3.0.7",
    "@ai-sdk/deepseek": "^3.0.7",
    "@ai-sdk/google": "^4.0.12",
    "@ai-sdk/groq": "^4.0.8",
    "@ai-sdk/openai": "^4.0.11",
    "@ai-sdk/openai-compatible": "^3.0.7",
    "@fontsource-variable/geist-mono": "^5.2.6",
    "@fontsource-variable/noto-serif": "^5.2.7",
    "@fontsource/mali": "^5.2.6",
    "@fontsource/opendyslexic": "^5.2.5",
    "@humanspeak/svelte-markdown": "^1.7.10",
    "@internationalized/date": "^3.12.2",
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "@tailwindcss/vite": "^4.1.8",
    "@tiptap/core": "3.27.3",
    "@tiptap/extension-placeholder": "3.27.3",
    "@tiptap/markdown": "3.27.3",
    "@tiptap/pm": "3.27.3",
    "@tiptap/starter-kit": "3.27.3",
    "@tiptap/suggestion": "^3.27.3",
    "ai": "^7.0.22",
    "ai-sdk-ollama": "^4.0.0",
    "animejs": "^4.0.2",
    "bits-ui": "^2.18.1",
    "crypto-js": "^4.2.0",
    "defuddle": "0.19.1",
    "highlight.js": "^11.11.1",
    "highlightjs-svelte": "^1.0.6",
    "html-entities": "^2.6.0",
    "jszip": "^3.10.1",
    "marked": "^18.0.6",
    "ollama-ai-provider-v2": "^4.0.1",
    "overlayscrollbars": "^2.11.1",
    "overlayscrollbars-svelte": "^0.5.5",
    "rehype-highlight": "^7.0.2",
    "rehype-raw": "^7.0.0",
    "svelte-i18n": "^4.0.1",
    "svelte-sonner": "^1.0.6",
    "tailwindcss": "^4.1.8",
    "webextension-polyfill": "^0.12.0",
    "youtube-transcript-plus": "github:spaceman1412/youtube-transcript-plus-nonodejs",
    "zod": "^4.4.3"
  }
}
